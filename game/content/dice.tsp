; the dog's five dice, six faces each: die d's faces are rows d * 6 to d * 6 + 5. A face's icon
; is its picture in the tray.

(import state)
(import content/effects fx)
(import art/sprites art)

(const DIE_COUNT u8 5)
(const FACES_PER_DIE u8 6)

(let faces (array fx.Action 30)
    (make (array fx.Action 30)
        ; 1: the wand, zaps
        (make fx.Action
            :effect fx.Effect.zap
            :amount 2
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_WAND)
        (make fx.Action
            :effect fx.Effect.zap
            :amount 3
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_WAND)
        (make fx.Action
            :effect fx.Effect.zap
            :amount 3
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_WAND)
        (make fx.Action
            :effect fx.Effect.zap
            :amount 4
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_WAND)
        (make fx.Action
            :effect fx.Effect.zap
            :amount 5
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_WAND)
        (make fx.Action
            :effect fx.Effect.fizzle
            :amount 0
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_PUFF)
        ; 2: the fang, bites
        (make fx.Action
            :effect fx.Effect.bite
            :amount 2
            :motion state.Motion.lunge
            :aim state.Aim.foe
            :icon art.TILE_FANG)
        (make fx.Action
            :effect fx.Effect.bite
            :amount 3
            :motion state.Motion.lunge
            :aim state.Aim.foe
            :icon art.TILE_FANG)
        (make fx.Action
            :effect fx.Effect.bite
            :amount 3
            :motion state.Motion.lunge
            :aim state.Aim.foe
            :icon art.TILE_FANG)
        (make fx.Action
            :effect fx.Effect.bite
            :amount 4
            :motion state.Motion.lunge
            :aim state.Aim.foe
            :icon art.TILE_FANG)
        (make fx.Action
            :effect fx.Effect.bite
            :amount 6
            :motion state.Motion.lunge
            :aim state.Aim.foe
            :icon art.TILE_FANG)
        (make fx.Action
            :effect fx.Effect.fizzle
            :amount 0
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_PUFF)
        ; 3: the leaf, shields
        (make fx.Action
            :effect fx.Effect.guard
            :amount 2
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_LEAF)
        (make fx.Action
            :effect fx.Effect.guard
            :amount 3
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_LEAF)
        (make fx.Action
            :effect fx.Effect.guard
            :amount 3
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_LEAF)
        (make fx.Action
            :effect fx.Effect.guard
            :amount 4
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_LEAF)
        (make fx.Action
            :effect fx.Effect.guard
            :amount 5
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_LEAF)
        (make fx.Action
            :effect fx.Effect.mend
            :amount 2
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_HEART)
        ; 4: the candle, sets things burning
        (make fx.Action
            :effect fx.Effect.ember
            :amount 1
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_CANDLE)
        (make fx.Action
            :effect fx.Effect.ember
            :amount 2
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_CANDLE)
        (make fx.Action
            :effect fx.Effect.ember
            :amount 2
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_CANDLE)
        (make fx.Action
            :effect fx.Effect.ember
            :amount 3
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_CANDLE)
        (make fx.Action
            :effect fx.Effect.zap
            :amount 2
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_WAND)
        (make fx.Action
            :effect fx.Effect.fizzle
            :amount 0
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_PUFF)
        ; 5: the ghost, spooks and mends
        (make fx.Action
            :effect fx.Effect.boo
            :amount 1
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_GHOST)
        (make fx.Action
            :effect fx.Effect.boo
            :amount 2
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_GHOST)
        (make fx.Action
            :effect fx.Effect.mend
            :amount 2
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_HEART)
        (make fx.Action
            :effect fx.Effect.mend
            :amount 3
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_HEART)
        (make fx.Action
            :effect fx.Effect.guard
            :amount 2
            :motion state.Motion.hop
            :aim state.Aim.self
            :icon art.TILE_LEAF)
        (make fx.Action
            :effect fx.Effect.zap
            :amount 3
            :motion state.Motion.throw
            :aim state.Aim.foe
            :icon art.TILE_WAND)))
