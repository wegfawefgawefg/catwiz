# Catwiz's play records (tools/telemetry/receiver.py), on the dev VPS as
# /etc/systemd/system/catwiz-telemetry.service, the receiver at /opt/catwiz-telemetry/receiver.py.
# The records: /var/lib/catwiz-telemetry/events.jsonl (tools/telemetry/report.py reads it).
[Unit]
Description=Catwiz anonymous play records
After=network.target

[Service]
DynamicUser=yes
ExecStart=/usr/bin/python3 /opt/catwiz-telemetry/receiver.py --port 8795
Restart=on-failure
RestartSec=2
StateDirectory=catwiz-telemetry
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryMax=64M
TasksMax=64

[Install]
WantedBy=multi-user.target
