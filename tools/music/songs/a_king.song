; a_king: the Bulldog King's boss theme, a pompous, menacing royal march
; key: C minor (harmonic: B in the G chords); B goes through Ab, Fm and the Neapolitan Db
; tempo: a 16th of 9 ticks (quarter = 100 bpm), 4/4, a bar of 144 ticks (2.4 s)
; form: a 2-bar herald's call once, then A (8 bars) and B (8 bars) round and round; it repeats
;   exactly after 38.4 s (16 bars), after the 4.8 s call
;   A, the march, dotted fanfare tune:  Cm G Ab G | Cm Fm G Cm
;   B, the anthem, broad tune over a pumping bass and rolls:  Ab Ab Fm Fm | Db Db G G
; size: 887 bytes (over the 395-byte buffer: this is the one that shows what up to 900 buys)
;
; voice 0 bass: the hardware envelope's saw (left chip, tone off), its period the pitch (122
;   C1, 61 C2, 81 G1, 54 D2, 77 G#1, 51 D#2, 91 F1, 65 B1, 115 C#1, 72 A1); A: tuba on
;   beats 1 and 3; B: staccato eighths, walking up G A B into the next A
; voice 1 the first trumpet, the tune: triplet calls, A's dotted fanfare, B's long lines
; voice 2 the second trumpet: A in thirds and sixths with the tune; B held notes under it (lent)
; voice 3 snare: A a march with ghost notes; B stomps on 2 and 4, then rolls (the right
;   chip's envelope, a saw at about 22 Hz, makes a roll from one note)
; voice 4 horn: A on beats 2 and 4 (oom-pah with the bass); B off-beat eighths
; voice 5 timpani: A on bar starts; B roots on 1 and 3, rolls into Db and into A (lent)
; patterns set their volumes in the intros: each voice keeps its own. The envelope bass sounds
;   at full level, so this plays about 10 dB louder than the battle song
(pattern call_lead "l12 v13 k8 g4 g4 g4 l36 c5 l12 g4 g4 g4 l36 d#5 l12 g4 c5 d#5 l36 g5 - r")
(pattern call_harm "l2 r l12 v10 k8 d#4 d#4 d#4 l36 g4 l12 d#4 d#4 d#4 l36 g4 l12 d#4 g4 c5 l36 d#5 - r")
(pattern call_bass "l1 r m0 l36 r h8:122 c1 r c1 r c1 - r")
(pattern call_snare "l3 r m2 n5 k1 l36 h8:180 c4 - - - l12 v12 c4 c4 c4 l36 v15 c4 r r")
(pattern call_horn "l64 r r l56 r l36 v10 k4 c4 - r")
(pattern call_timp "l4 r l36 h8:180 c2 - - - l36 v15 k3 r c2 r r")
(pattern lead_a
    "l27 g4 l9 g4 l36 c5 l27 c5 l9 d5 l36 d#5 l27 d5 l9 c5 l36 d5 g4 - l27 c5 l9 c5 l36 d#5 l27 d#5 l9 f5 l36 g#5 g5 - l27 f5 l9 d5 l36 b4 c6 - l27 g5 l9 g5 l36 d#5 l27 f5 l9 g5 l36 g#5 l27 g#5 l9 g5 l36 f5 l27 g5 l9 g5 l36 f5 d5 b4 c5 - - r")
(pattern lead_b
    "l36 g#4 - c5 d#5 c6 - a#5 g#5 g#5 - g5 f5 c5 - f5 g#5 c#6 - - c6 a#5 - g#5 f5 g5 - - f5 d5 - b4 r")
(pattern harm_a
    "l27 d#4 l9 d#4 l36 g4 l27 g4 l9 f4 l36 g4 l27 b4 l9 g4 l36 b4 b3 - l27 g#4 l9 g#4 l36 c5 l27 c5 l9 d5 l36 c5 d5 - l27 d5 l9 b4 l36 g4 g5 - l27 d#5 l9 d#5 l36 c5 l27 g#4 l9 a#4 l36 c5 l27 c5 l9 a#4 l36 g#4 l27 d5 l9 d5 l36 b4 g4 f4 d#4 - - r")
(pattern harm_b
    "l36 d#4 - g#4 c5 d#5 - - c5 c5 - a#4 g#4 g#4 - c5 c5 f5 - - f5 c#5 - - g#4 b4 - - d5 b4 - g4 r")
(pattern bass_a
    "l36 h8:61 c2 r h8:81 g1 r g1 r h8:54 d2 r h8:77 g#1 r h8:51 d#2 r h8:81 g1 r h8:54 d2 r h8:61 c2 r h8:81 g1 r h8:91 f1 r h8:61 c2 r h8:81 g1 r h8:65 b1 r h8:61 c2 r h8:122 c1 r")
(pattern pump_ab "h8:77 l9 g#1 r g#1 r g#1 r g#1 r g#1 r g#1 r g#1 r g#1 r")
(pattern pump_f "h8:91 f1 r f1 r f1 r f1 r f1 r f1 r f1 r f1 r")
(pattern pump_db "h8:115 c#1 r c#1 r c#1 r c#1 r c#1 r c#1 r c#1 r c#1 r")
(pattern pump_g "h8:81 g1 r g1 r g1 r g1 r g1 r g1 r g1 r g1 r")
(pattern walk_up "h8:81 g1 r g1 r g1 r g1 r h8:72 a1 r a1 r h8:65 b1 r b1 r")
(pattern snare_a "l9 v13 k1 c4 r v6 c4 c4 v13 c4 r v6 c4 r v13 c4 r v6 c4 c4 v13 c4 v6 c4 c4 c4")
(pattern snare_fill "l36 v14 k1 c4 v10 c4 h8:180 c4 -")
(pattern snare_stomp "l36 v13 k1 r c4 l27 r l9 v7 c4 l36 v13 c4")
(pattern snare_roll "l36 h8:180 c4 - - v14 k1 c4")
(pattern horn_a "l36 r c4 r c4 r b3 r b3 r c4 r c4 r b3 r b3 r c4 r c4 r c4 r c4 r b3 r b3 r c4 r c4")
(pattern horn_ab "l18 r d#4 r d#4 r d#4 r d#4")
(pattern horn_f "r c4 r c4 r c4 r c4")
(pattern horn_db "r f4 r f4 r f4 r f4")
(pattern horn_g "r d4 r d4 r d4 r d4")
(pattern timp_a "l36 v14 k3 c2 r r r g1 r r r g#1 r r r g1 r r r c2 r r r f1 r r r g1 r r r c2 r r r")
(pattern timp_b "g#1 r d#2 r g#1 r d#2 r f1 r c2 r f1 r h8:180 c2 - v14 c#2 r g#1 r c#2 r g#1 r g1 g1 g1 g1 g1 r h8:180 g1 -")
(voice 0 call_bass loop bass_a pump_ab pump_ab pump_f pump_f pump_db pump_db pump_g walk_up)
(voice 1 call_lead loop lead_a lead_b)
(voice 2 call_harm loop harm_a harm_b)
(voice 3 call_snare loop snare_a snare_a snare_a snare_a snare_a snare_a snare_a snare_fill
    snare_stomp snare_stomp snare_stomp snare_stomp snare_roll snare_roll snare_roll snare_fill)
(voice 4 call_horn loop horn_a horn_ab horn_ab horn_f horn_f horn_db horn_db horn_g horn_g)
(voice 5 call_timp loop timp_a timp_b)
